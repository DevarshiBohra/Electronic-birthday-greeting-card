  }
  if (displayIteration < iterationCounter || displayIteration > iterationCounter + 4) {
    generateNewDisplayIteration();
  }
}


void loop() {
  iterationCounter++;

  displaydate();
  
  for (int counter = 0; counter < 28; counter++) {
        u8g2.clearBuffer();  
        u8g2.drawXBMP(39, 7, 50, 50, epd_bitmap_allArray[counter]);  
        u8g2.sendBuffer(); 
  }

  digitalWrite(ledPin, HIGH);

  u8g2.clearBuffer();
  u8g2.setFont(u8g2_font_9x18B_tr);
  u8g2.drawStr(0,25, "Happy Birthday,");
  u8g2.drawStr(15,45, "Niharikaa!!");
  u8g2.sendBuffer();

  playHappyBirthday();

  u8g2.clearBuffer();
  u8g2.setFont(u8g2_font_9x18B_tr);
  u8g2.drawStr(12,27, "Blow on the");
  u8g2.drawStr(18,45, "microphone.");
  u8g2.sendBuffer();

  do {
    mn = 1024;  
    mx = 0;
    delta = 0;
    i = 0;

    while (i < 10000 && delta < 800) {
      int val = analogRead(micPin);

      mn = min(mn, val);
      mx = max(mx, val);
      delta = mx - mn;
      i++;
    }
  } while (delta < 450);
  

  digitalWrite(ledPin, LOW);

  u8g2.clearBuffer();
  u8g2.setFont(u8g2_font_9x18B_tr);
  u8g2.drawStr(0,10, "Have a great");
  u8g2.drawStr(0,35, "year, cat-math");
  u8g2.drawStr(0,60, "loving wierdo!");
  u8g2.sendBuffer();
  delay(4000);

 
  
  for (int counterr = 0; counterr < 16; counterr++) {
        u8g2.clearBuffer();  
        u8g2.drawXBMP(39, 7, 50, 50, epd_bitmap_allArray_[counterr]);  
        u8g2.sendBuffer(); 
        delay(30);
  }

  delay(1000);

 if (iterationCounter >= displayIteration) {
    // Display the special text message
    u8g2.clearBuffer();
    u8g2.setFont(u8g2_font_9x18B_tr);
    u8g2.drawStr(0, 35, specialMessages[messageIndex]);
    u8g2.sendBuffer();
    delay(2500);  

    generateNewDisplayIteration();
  }

  EEPROM.put(counterAddress, iterationCounter);
}

