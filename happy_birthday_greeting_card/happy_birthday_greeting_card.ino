const int notes = sizeof(melody) / sizeof(melody[0]) / 2;
const int wholenote = (60000 * 4) / tempo;

void playHappyBirthday() {
  for (int thisNote = 0; thisNote < notes * 2; thisNote += 2) {
    int divider = pgm_read_word_near(melody + thisNote + 1);
    int noteDuration = (divider > 0) ? (wholenote / divider) : ((wholenote / abs(divider)) * 1.5);

    tone(buzzerPin, pgm_read_word_near(melody + thisNote), noteDuration * 0.9);
    delay(noteDuration);
    noTone(buzzerPin);
  }
}

